# AI 图片/视频生成 API 配置 (AtlasCloud)
AI_IMAGE_API_KEY=your_api_key_here
AI_IMAGE_API_BASE=https://api.atlascloud.ai/api/v1
AI_IMAGE_MODEL=google/imagen4

# Required: shared secret for POST /api/generate (server-side only — never NEXT_PUBLIC_)
GENERATE_ACCESS_TOKEN=change-me-to-a-long-random-secret

# Optional: trust N reverse proxies that append to X-Forwarded-For (default 0 = ignore client XFF)
# GENERATE_TRUSTED_PROXY_HOPS=1

# Optional: shared Redis quota store (Upstash REST). Required for multi-instance/serverless.
# GENERATE_QUOTA_REDIS_URL=https://xxxx.upstash.io
# GENERATE_QUOTA_REDIS_TOKEN=...
# Or standard Upstash names:
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# Fail closed when Redis is unset (recommended in production multi-instance):
# GENERATE_REQUIRE_SHARED_QUOTA=1

# Optional: per-IP burst + daily quotas
# GENERATE_RATE_LIMIT=5
# GENERATE_RATE_WINDOW_MS=60000
# GENERATE_DAILY_QUOTA=20
# GENERATE_BUCKET_TTL_MS=172800000
