# AI 图片/视频生成 API 配置 (AtlasCloud)
AI_IMAGE_API_KEY=your_api_key_here
AI_IMAGE_API_BASE=https://api.atlascloud.ai/api/v1
AI_IMAGE_MODEL=google/imagen4

# Required: shared secret for POST /api/generate (server-side check)
GENERATE_ACCESS_TOKEN=change-me-to-a-long-random-secret

# Browser/client must send the same value (Authorization: Bearer … or x-generate-token)
NEXT_PUBLIC_GENERATE_ACCESS_TOKEN=change-me-to-a-long-random-secret

# Optional: per-IP burst + daily quotas (in-memory; resets on process restart)
# GENERATE_RATE_LIMIT=5
# GENERATE_RATE_WINDOW_MS=60000
# GENERATE_DAILY_QUOTA=20
